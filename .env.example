# Supabase Configuration (Optional - falls back to local storage if omitted)
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Provider Configuration
# Supported providers: gemini, mock (default)
VITE_AI_PROVIDER=gemini

# Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model (default: gemini-3.6-flash)
VITE_GEMINI_MODEL=gemini-3.6-flash

# Google Analytics & Google Ads Tracking (Optional)
# GA4 Measurement ID (e.g. G-XXXXXXXXXX) from Google Analytics
VITE_GA_MEASUREMENT_ID=
# Google Ads Conversion ID (e.g. AW-XXXXXXXXXX) from Google Ads
VITE_GOOGLE_ADS_ID=
